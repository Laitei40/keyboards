<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>psalter_pahlavi_phonetic</kbdname>
    <flags>
      <displayunderlying/>
      <usealtgr/>
    </flags>
  </header>
  <encoding name="unicode" fontname="Noto Sans Psalter Pahlavi" fontsize="12">
    <layer shift="">
      <key vkey="K_BKQUOTE">`</key>
      <key vkey="K_1">𐮩</key>
      <key vkey="K_2">𐮪</key>
      <key vkey="K_3">𐮫</key>
      <key vkey="K_4">𐮬</key>
      <key vkey="K_5">𐮭</key>
      <key vkey="K_6">𐮮</key>
      <key vkey="K_7">𐮯</key>
      <key vkey="K_8">𐮙</key>
      <key vkey="K_9">𐮚</key>
      <key vkey="K_0">𐮛</key>
      <key vkey="K_HYPHEN">𐮜</key>
      <key vkey="K_EQUAL">=</key>
      <key vkey="K_W">𐮅</key>
      <key vkey="K_E">𐮏</key>
      <key vkey="K_Y">𐮑</key>
      <key vkey="K_I">𐮈</key>
      <key vkey="K_P">𐮎</key>
      <key vkey="K_LBRKT">[</key>
      <key vkey="K_RBRKT">]</key>
      <key vkey="K_BKSLASH">\</key>
      <key vkey="K_A">𐮀</key>
      <key vkey="K_S">𐮍</key>
      <key vkey="K_D">𐮃</key>
      <key vkey="K_G">𐮂</key>
      <key vkey="K_H">𐮄</key>
      <key vkey="K_K">𐮉</key>
      <key vkey="K_L">𐮊</key>
      <key vkey="K_COLON">;</key>
      <key vkey="K_QUOTE">'</key>
      <key vkey="K_oE2">\</key>
      <key vkey="K_Z">𐮆</key>
      <key vkey="K_X">𐮐</key>
      <key vkey="K_C">𐮇</key>
      <key vkey="K_B">𐮁</key>
      <key vkey="K_N">𐮌</key>
      <key vkey="K_M">𐮋</key>
      <key vkey="K_COMMA">,</key>
      <key vkey="K_PERIOD">.</key>
      <key vkey="K_SLASH">/</key>
    </layer>
    <layer shift="S">
      <key vkey="K_BKQUOTE">~</key>
      <key vkey="K_1">!</key>
      <key vkey="K_2">@</key>
      <key vkey="K_3">#</key>
      <key vkey="K_4">$</key>
      <key vkey="K_5">%</key>
      <key vkey="K_6">^</key>
      <key vkey="K_7">&amp;</key>
      <key vkey="K_8">*</key>
      <key vkey="K_9">(</key>
      <key vkey="K_0">)</key>
      <key vkey="K_HYPHEN">_</key>
      <key vkey="K_EQUAL">+</key>
      <key vkey="K_LBRKT">{</key>
      <key vkey="K_RBRKT">}</key>
      <key vkey="K_BKSLASH">|</key>
      <key vkey="K_COLON">:</key>
      <key vkey="K_QUOTE">"</key>
      <key vkey="K_oE2">|</key>
      <key vkey="K_COMMA">&lt;</key>
      <key vkey="K_PERIOD">&gt;</key>
      <key vkey="K_SLASH">?</key>
    </layer>
    <layer shift="RA">
      <key vkey="K_0">0</key>
      <key vkey="K_1">1</key>
      <key vkey="K_2">2</key>
      <key vkey="K_3">3</key>
      <key vkey="K_4">4</key>
      <key vkey="K_5">5</key>
      <key vkey="K_6">6</key>
      <key vkey="K_7">7</key>
      <key vkey="K_8">8</key>
      <key vkey="K_9">9</key>
      <key vkey="K_HYPHEN">-</key>
    </layer>
  </encoding>
</visualkeyboard>
