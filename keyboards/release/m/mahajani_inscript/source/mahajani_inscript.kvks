<?xml version="1.0" encoding="utf-8"?>
<visualkeyboard>
  <header>
    <version>10.0</version>
    <kbdname>mahajani_inscript</kbdname>
    <flags>
      <displayunderlying/>
      <usealtgr/>
    </flags>
  </header>
  <encoding name="unicode" fontname="Noto Sans Mahajani" fontsize="12">
    <layer shift="">
      <key vkey="K_BKQUOTE">`</key>
      <key vkey="K_1">१</key>
      <key vkey="K_2">२</key>
      <key vkey="K_3">३</key>
      <key vkey="K_4">४</key>
      <key vkey="K_5">५</key>
      <key vkey="K_6">६</key>
      <key vkey="K_7">७</key>
      <key vkey="K_8">८</key>
      <key vkey="K_9">९</key>
      <key vkey="K_0">०</key>
      <key vkey="K_HYPHEN">-</key>
      <key vkey="K_EQUAL">=</key>
      <key vkey="K_E">𑅐</key>
      <key vkey="K_Y">𑅪</key>
      <key vkey="K_U">𑅱</key>
      <key vkey="K_I">𑅗</key>
      <key vkey="K_O">𑅥</key>
      <key vkey="K_P">𑅛</key>
      <key vkey="K_LBRKT">𑅠</key>
      <key vkey="K_RBRKT">𑅳</key>
      <key vkey="K_BKSLASH">𑅴</key>
      <key vkey="K_A">𑅔</key>
      <key vkey="K_S">𑅓</key>
      <key vkey="K_F">𑅑</key>
      <key vkey="K_G">𑅒</key>
      <key vkey="K_H">𑅨</key>
      <key vkey="K_J">𑅭</key>
      <key vkey="K_K">𑅕</key>
      <key vkey="K_L">𑅣</key>
      <key vkey="K_COLON">𑅙</key>
      <key vkey="K_QUOTE">𑅞</key>
      <key vkey="K_oE2">\</key>
      <key vkey="K_Z">𑅵</key>
      <key vkey="K_X">𑅶</key>
      <key vkey="K_C">𑅬</key>
      <key vkey="K_V">𑅧</key>
      <key vkey="K_B">𑅯</key>
      <key vkey="K_N">𑅮</key>
      <key vkey="K_M">𑅰</key>
      <key vkey="K_COMMA">,</key>
      <key vkey="K_PERIOD">।</key>
      <key vkey="K_SLASH">॥</key>
    </layer>
    <layer shift="S">
      <key vkey="K_BKQUOTE">~</key>
      <key vkey="K_1">!</key>
      <key vkey="K_2">@</key>
      <key vkey="K_3">#</key>
      <key vkey="K_4">$</key>
      <key vkey="K_5">%</key>
      <key vkey="K_6">^</key>
      <key vkey="K_7">&amp;</key>
      <key vkey="K_8">*</key>
      <key vkey="K_9">(</key>
      <key vkey="K_0">)</key>
      <key vkey="K_HYPHEN">_</key>
      <key vkey="K_EQUAL">+</key>
      <key vkey="K_Y">𑅫</key>
      <key vkey="K_I">𑅘</key>
      <key vkey="K_O">𑅦</key>
      <key vkey="K_P">𑅜</key>
      <key vkey="K_LBRKT">𑅡</key>
      <key vkey="K_RBRKT">𑅝</key>
      <key vkey="K_BKSLASH">|</key>
      <key vkey="K_H">𑅩</key>
      <key vkey="K_J">𑅲</key>
      <key vkey="K_K">𑅖</key>
      <key vkey="K_L">𑅤</key>
      <key vkey="K_COLON">𑅚</key>
      <key vkey="K_QUOTE">𑅟</key>
      <key vkey="K_oE2">|</key>
      <key vkey="K_C">𑅢</key>
      <key vkey="K_COMMA">&lt;</key>
      <key vkey="K_PERIOD">&gt;</key>
      <key vkey="K_SLASH">?</key>
    </layer>
    <layer shift="RA">
      <key vkey="K_0">0</key>
      <key vkey="K_1">1</key>
      <key vkey="K_2">2</key>
      <key vkey="K_3">3</key>
      <key vkey="K_4">4</key>
      <key vkey="K_5">5</key>
      <key vkey="K_6">6</key>
      <key vkey="K_7">7</key>
      <key vkey="K_8">8</key>
      <key vkey="K_9">9</key>
      <key vkey="K_COLON">:</key>
      <key vkey="K_COMMA">·</key>
    </layer>
  </encoding>
</visualkeyboard>
